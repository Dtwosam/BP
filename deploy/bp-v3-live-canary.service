[Unit]
Description=BP frozen V3 single-order live canary
After=network-online.target bp-postgres.service bp-v3-frozen-predictor.service
Wants=network-online.target

[Service]
Type=simple
User=bp
Group=bp
WorkingDirectory=/opt/bp
EnvironmentFile=/etc/bp/bp-v3-live-canary.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/bp/.venv/bin/python /var/lib/bp/runtime/v3-live-canary-current/scripts/run_v3_live_canary.py
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bp/live-canary
ProtectHome=true

[Install]
WantedBy=multi-user.target
