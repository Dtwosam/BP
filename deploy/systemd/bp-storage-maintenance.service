[Unit]
Description=BP Phase 3 fail-closed storage maintenance
Requires=bp-postgres.service
After=bp-postgres.service

[Service]
Type=oneshot
User=bp
Group=bp
WorkingDirectory=/opt/bp
EnvironmentFile=/etc/bp/bp.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/bp/.venv/bin/python /opt/bp/scripts/storage_maintenance.py run
TimeoutStartSec=55min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-storage-maintenance
