[Unit]
Description=BP fail-closed recorder stop on critical disk health
After=bp-storage-disk-health.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl stop bp-recorder.service
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bp-storage-critical-stop
